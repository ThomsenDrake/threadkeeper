{
  "name": "threadkeeper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "api": "node --import tsx apps/api/src/index.ts",
    "worker": "node --import tsx apps/worker/src/index.ts",
    "dev:web": "pnpm --filter @threadkeeper/web dev",
    "build": "pnpm --filter @threadkeeper/web build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "migrate": "node --import tsx deploy/migrate.ts",
    "reindex": "node --import tsx deploy/reindex.ts",
    "provider:check": "node --import tsx deploy/provider-check.ts",
    "demo": "node --import tsx deploy/demo.ts",
    "integration": "node --import tsx deploy/integration/run.ts",
    "dev:demo": "node --import tsx deploy/dev-demo.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.0",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.0",
    "express": "5.1.0",
    "pg": "8.16.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-pgvector": "0.0.9",
    "@types/express": "5.0.3",
    "@types/node": "24.7.2",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.9"
  }
}
