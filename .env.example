# Local container setup: copy this file to .env and choose your own secrets.
# Keep .env out of version control. Do not paste secrets into chat.
POSTGRES_PASSWORD=
BOOTSTRAP_EMAIL=owner@example.test
BOOTSTRAP_PASSWORD=

HOST=0.0.0.0
PORT=3000
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# For a host-run service. Compose sets the database hostname to postgres.
# Use a URL-safe password here or percent-encode special characters.
DATABASE_URL=postgresql://threadkeeper:REPLACE_WITH_URL_SAFE_PASSWORD@localhost:5432/threadkeeper

# Hackathon provider. Do not silently replace this model.
MODEL_BASE_URL=https://api.tokenfactory.nebius.com/v1/
MODEL_ID=nvidia/Nemotron-3_5-Lightning
NEBIUS_API_KEY=
# Optional explicit provider key; takes precedence over NEBIUS_API_KEY.
MODEL_API_KEY=
MODEL_TIMEOUT_MS=60000
MODEL_MAX_OUTPUT_TOKENS=4096
# json_object has a successful live check. Schema enforcement is not established.
MODEL_JSON_OBJECT=true
MODEL_STRUCTURED_OUTPUT=false
MODEL_MAX_EVENTS=32
MODEL_MAX_SOURCE_CHARACTERS=64000
WORKER_POLL_MS=1000

# Optional hybrid recall. Leave the model empty for credential-free full-text
# recall. Set the same endpoint/model/dimensions on API and worker. Local
# OpenAI-compatible embedding endpoints do not require a provider API key.
# With a model configured, application startup requires explicit dimensions
# (1..16000). The optional provider probe can measure them when left empty.
# The tested account exposes Qwen/Qwen3-Embedding-8B with 4096 dimensions.
# The configured dimension is sent to the provider; it must support that value.
# Native pgvector compatibility is checked before exact cosine retrieval; no
# approximate index is selected. Full-text recall remains usable if unavailable.
# Rebuild current embeddings after changing this configuration: pnpm reindex
# Host-run command: node --env-file=.env --import tsx deploy/reindex.ts
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=https://api.tokenfactory.nebius.com/v1/
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=
EMBEDDING_TIMEOUT_MS=60000

# Fully local operation uses the same application. Point these variables at
# operator-run servers and clear all Nebius credentials. This recipe still
# requires a measured GPU/embedding-server validation before claiming parity.
# MODEL_BASE_URL=http://host.docker.internal:8000/v1/
# MODEL_ID=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4
# EMBEDDING_BASE_URL=http://host.docker.internal:8080/v1/
# EMBEDDING_MODEL=YOUR_LOCAL_EMBEDDING_MODEL
# EMBEDDING_DIMENSIONS=YOUR_MEASURED_DIMENSIONS
